#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
char* removeDuplicateLetters(char* s) {
    int len = strlen(s);
    int count[26] = {0};
    bool visited[26] = {false};
    char* stack = (char*)malloc((len + 1) * sizeof(char));
    int top = 0;
    for (int i = 0; i < len; i++) {
        count[s[i] - 'a']++;
    }
    for (int i = 0; i < len; i++) {
        int idx = s[i] - 'a';
        count[idx]--;
        if (visited[idx]) {
            continue;
        }
        while (top > 0 && stack[top - 1] > s[i] && count[stack[top - 1] - 'a'] > 0) {
            visited[stack[top - 1] - 'a'] = false;
            top--;
        }
        stack[top++] = s[i];
        visited[idx] = true;
    }
    stack[top] = '\0';
    return stack;
}
