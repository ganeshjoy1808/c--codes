#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
	
    int n,s,x;
    scanf("%d", &n);
    //Complete the code to calculate the sum of the five digits on n.
    s=0;
    while(n>0)
    {
        x=n%10;
        s=s+x;
        n=n/10;
    }
    printf("%d",s);
    return 0;
}
