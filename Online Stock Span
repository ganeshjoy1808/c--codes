#define MAX_CALLS 10005
typedef struct {
    int price;
    int span;
} PriceSpan;
typedef struct {
    PriceSpan stack[MAX_CALLS];
    int top;
} StockSpanner;
StockSpanner* stockSpannerCreate() {
    StockSpanner* spanner = (StockSpanner*)malloc(sizeof(StockSpanner));
    spanner->top = -1;
    return spanner;
}
int stockSpannerNext(StockSpanner* obj, int price) {
    int currentSpan = 1;
    while (obj->top >= 0 && obj->stack[obj->top].price <= price) {
        currentSpan += obj->stack[obj->top].span;
        obj->top--;
    }
    obj->top++;
    obj->stack[obj->top].price = price;
    obj->stack[obj->top].span = currentSpan;
    return currentSpan;
}
void stockSpannerFree(StockSpanner* obj) {
    free(obj);
}
